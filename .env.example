# Het contactformulier verstuurt via de eigen mailserver van flamme-yachtdesign.com.
# Deze gegevens krijg je van de partij die de mail host. Zet ze in Vercel onder
# Settings, Environment Variables, en deploy daarna opnieuw: een bestaande deploy
# pikt een nieuwe variabele niet vanzelf op.
#
# Zolang ze ontbreken toont het formulier een foutmelding met het e-mailadres
# erbij, in plaats van een bevestiging voor een bericht dat nergens aankomt.

# Uitgaande mailserver, bijvoorbeeld smtp.jouwprovider.nl
SMTP_HOST=

# 465 voor directe TLS, 587 voor STARTTLS. Bij twijfel 465.
SMTP_PORT=465

# Het volledige e-mailadres waarmee wordt ingelogd. Dit adres komt ook in de
# afzender te staan.
SMTP_USER=

# Wachtwoord van die mailbox. Heeft je provider applicatiewachtwoorden, gebruik
# er daar dan een van in plaats van het gewone wachtwoord.
SMTP_PASSWORD=

# Waar de berichten heen gaan. Leeg laten betekent naar SMTP_USER.
CONTACT_TO=info@flamme-yachtdesign.com
